# Asterisk Environment Configuration
# Copy this file to .env and update with your actual values

# FritzBox SIP Registration Password
# This is the password for your Asterisk user on the FritzBox
ASTERISK_PASSWORD=your_secret_password_here

# Asterisk Server IP Address
# The IP address where this Asterisk instance is reachable by the FritzBox
ASTERISK_IP=192.168.1.100

# FritzBox IP Address
# The IP address of your FritzBox for incoming call identification
FRITZBOX_IP=192.168.1.1
