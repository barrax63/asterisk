# Note: config/ and data/ at the repo root are intentionally tracked in full -
# they are baked into the image at build time (see Dockerfile). Runtime state
# (logs, voicemail, recordings, etc.) lives in Docker named volumes, not in
# these directories, so no generated-file exclusions are needed for them.

# Environment files with secrets
.env

# Docker and build artifacts
*.log
.DS_Store
*~
*.swp
*.swo

# IDE and editor files
.vscode/
.idea/
*.iml

# Backup files
*.bak
*.backup
*.old

# Temporary files
/tmp/
*.tmp
